COMPOSE_FILE=docker-compose.yml

# Required — from Portainer server: Environments > Add environment > Edge Agent
EDGE_ID=
EDGE_KEY=

# Required for docker-compose.lan.yaml
PORTAINER_DOMAIN=portainer.local
PORTAINER_IP=127.0.0.1

# Optional overrides
TZ=Europe/Athens
PORTAINER_AGENT_CPU_LIMIT=0.5
PORTAINER_AGENT_MEMORY_LIMIT=128m
PORTAINER_AGENT_MEMORY_RESERVATION=32m
PORTAINER_AGENT_PIDS_LIMIT=200
